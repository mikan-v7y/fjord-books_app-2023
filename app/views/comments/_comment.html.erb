<% if commentable.comments.any? %>
  <% commentable.comments.each do |comment| %>
    <div class="comment">
      <p><strong><%= comment.user.display_name %></strong> さんが <%= l(comment.created_at, format: :short) %> に投稿:</p>
      <p><%= comment.content %></p>
    </div>

    <% if comment.user == current_user %>
      <%= button_to "編集", edit_polymorphic_path([commentable, comment]), method: :get %>
      <%= button_to "削除", polymorphic_path([commentable, comment]), method: :delete %>
    <% end %>
  <% end %>
<% else %>
  <p>まだコメントはありません。</p>
<% end %>
