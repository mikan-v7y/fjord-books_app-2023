<% if commentable.comments.any? %>
  <% commentable.comments.each do |comment| %>
    <div class="comment">
      <p><strong><%= comment.user.display_name %></strong> さんが <%= l(comment.created_at, format: :short) %> に投稿:</p>
      <p><%= comment.content %></p>
    </div>

    <% if comment.user == current_user %>
      <%= button_to t('views.comments.list.edit'), edit_polymorphic_path([commentable, comment]), method: :get %>
      <%= button_to t('views.comments.list.delete'), polymorphic_path([commentable, comment]), method: :delete %>
    <% end %>
  <% end %>
<% else %>
  <p><%= t('views.comments.list.no_comments') %></p>
<% end %>
