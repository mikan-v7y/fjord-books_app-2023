<!DOCTYPE html>
<html>
  <head>
    <title>BooksApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= params[:action] %>">

    <p class="navbar-text float-right">
      <% if user_signed_in? %>
        <%= t('layouts.application.logged_in_as', email: current_user.email) %>
        <%= link_to t('.edit_'), edit_user_registration_path, class: "navbar-link" %> |
        <%= link_to t('.log_out'), destroy_user_session_path, data: { turbo_method: :delete }, class: "navbar-link" %>
      <% else %>
        <%= link_to t('.sign_up'), new_user_registration_path, class: "navbar-link" %> |
        <%= link_to t('.log_in'), new_user_session_path, class: "navbar-link" %>
      <% end %>
      </p>

    <%= yield %>
  </body>
</html>
