<div class="show-item">
  <%= render @report %>
</div>

<nav class="page-nav">
  <% if current_user == @report.user %>
    <%= link_to "Edit this report", edit_report_path(@report) %> |
  <% end %>

  <%= link_to "Back to reports", reports_path %>

  <% if current_user == @report.user %>
    <%= button_to "Destroy this report", @report, method: :delete %>
  <% end %>
</nav>

<h2>コメントを書き込む</h2>
<%= render "comments/form", commentable: @report %>

<h2>コメント一覧</h2>

<% if @report.comments.any? %>
  <% @report.comments.each do |comment| %>
    <div class="comment">
      <p><strong><%= comment.user.display_name %></strong> さんが <%= l(comment.created_at, format: :short) %> に投稿:</p>
      <p><%= comment.content %></p>
    </div>

    <% if comment.user == current_user %>
      <%= button_to "削除", report_comment_path(@report, comment), method: :delete %>
    <% end %>
  <% end %>
<% else %>
  <p>まだコメントはありません。</p>
<% end %>
