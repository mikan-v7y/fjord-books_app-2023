<div id="<%= dom_id report %>">
  <p>
    <strong>Title:</strong>
    <%= report.title %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= report.content %>
  </p>

  <p>
    <strong>Creator:</strong>
    <%= report.user.name %>
  </p>

  <p>
    <strong>Created_at:</strong>
    <%= l report.created_at, format: :short %>
  </p>

</div>
